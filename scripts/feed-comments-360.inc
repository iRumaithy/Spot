// Home feed uses the immutable publication timestamp, never the visit or edit date.
let spotFeedSource='all',spotFeedLimit=20;
const spotCommentCounts=new Map(),spotCommentDrafts=new Map();
let spotComments=null,spotCommentRefresh=null;
function spotFeedPosts(){return socialPosts(spotFeedSource,500).filter(p=>spotCanView(p.owner_id)&&state.visits.some(v=>v.id===p.visit_id)).sort((a,b)=>Date.parse(b.created_at)-Date.parse(a.created_at)||b.id.localeCompare(a.id))}
function home(){const posts=spotFeedPosts();return `<div class="spot-home-feed">${storyTray()}<div class="spot-feed-heading"><div class="spot-feed-tabs" role="group" aria-label="${spotUi('خلاصة المنشورات','Post feed')}"><button type="button" data-action="feed-all" aria-pressed="${spotFeedSource==='all'}">${spotUi('لك','For you')}</button><button type="button" data-action="feed-following" aria-pressed="${spotFeedSource==='following'}">${spotUi('تتابعهم','Following')}</button></div><button type="button" class="spot-feed-new" data-action="new-place" aria-label="${spotUi('تجربة جديدة','New experience')}">${ico('plus',19)}<span>${spotUi('تجربة جديدة','New experience')}</span></button></div><div class="spot-feed-status">${spotUi('الأحدث نشرًا أولًا','Newest posts first')}</div><section class="spot-feed-list" aria-label="${spotUi('آخر التجارب المنشورة','Latest published experiences')}">${posts.length?posts.slice(0,spotFeedLimit).map(postCard).join(''):empty(spotUi('هني تبدأ تجاربك','Your feed starts here'),spotFeedSource==='following'?spotUi('تابع أعضاء ليظهر جديد تجاربهم هنا.','Follow members to see their latest experiences.'):spotUi('شارك أول تجربة مع مجتمع Spot.','Share your first experience with Spot.'),spotFeedSource==='following'?'social-members':'new-place',spotUi('ابدأ من هنا','Get started'))}</section>${posts.length>spotFeedLimit?btn(spotUi('عرض منشورات أقدم','Show older posts'),'feed-more','outline wide'):posts.length?`<p class="spot-feed-end">${spotUi('وصلت لآخر المنشورات المحمّلة','You’re up to date')}</p>`:''}</div>`}
function spotFeedAuthor(author){const stories=spotVisibleStories(author.id),unseen=stories.some(s=>!state.storySeen.has(s.id));return `<div class="spot-feed-author"><button type="button" class="spot-feed-avatar ${stories.length?(unseen?'has-story unseen':'has-story'):''}" data-action="${stories.length?'open-stories':'show-member'}" data-id="${escape(author.id)}" aria-label="${escape(author.display_name)}${stories.length?' · '+spotUi('شاهد الستوري','View story'):''}">${avatar(author)}</button><button type="button" class="spot-feed-author-name" data-action="show-member" data-id="${escape(author.id)}"><b class="spot-user-content">${escape(author.display_name)}</b><small dir="ltr">@${escape(author.username)}</small></button></div>`}
function postCard(post){const p=state.places.find(x=>x.id===post.place_id),v=state.visits.find(x=>x.id===post.visit_id),author=state.people.find(x=>x.id===post.owner_id);if(!p||!v||!author||!spotCanView(author.id))return '';const items=visitItems(v.id),score=items.length?items.reduce((s,x)=>s+num(x.rating),0)/items.length:rating(p),count=spotCommentCounts.get(post.id)||0;return `<article class="post-card card spot-feed-post" data-feed-post="${escape(post.id)}"><header class="post-person">${spotFeedAuthor(author)}<time datetime="${escape(post.created_at)}" title="${escape(new Date(post.created_at).toLocaleString())}">${dt(post.created_at)}</time>${post.owner_id===state.me?.id?btn(ico('edit',17),'edit-review','ghost sm',`data-id="${escape(post.id)}" aria-label="${spotUi('تعديل تقييمي','Edit my review')}"`):''}</header><button type="button" class="post-cover" data-action="open-post" data-id="${escape(post.id)}" aria-label="${escape(p.name)}">${featuredPhoto(p)}<span class="post-kind">${iconType(p.type)} ${labelType(p.type)}</span></button><div class="post-content"><div class="spot-feed-actions">${spotLikeControl(post.id)}<button type="button" data-action="open-comments" data-id="${escape(post.id)}" aria-label="${spotUi('التعليقات','Comments')}">${ico('chat',24)}<span data-comment-count="${escape(post.id)}">${count}</span></button><button type="button" data-action="share-post" data-id="${escape(post.id)}" aria-label="${spotUi('مشاركة التجربة','Share experience')}">${ico('share',23)}</button><button type="button" class="spot-feed-save" data-action="favorite" data-id="${escape(p.id)}" aria-pressed="${state.likes.has(p.id)}" aria-label="${spotUi('حفظ المكان','Save place')}">${ico('book',23)}</button></div>${imageCredit(p.cover_credit,p.cover_source)}<div class="post-place"><button type="button" class="spot-feed-place" data-action="open-post" data-id="${escape(post.id)}"><h3 class="spot-user-content">${escape(p.name)}</h3><span>${ico('pin',13)}<span class="spot-user-content">${escape(spotCanonicalCity(p.city))}</span></span></button><strong>${score?'★ '+score.toFixed(1):''}</strong></div>${v.notes||p.notes?`<p class="post-review spot-user-content"><b>${escape(author.username)}</b> ${escape(v.notes||p.notes)}</p>`:''}${items.length?`<div class="post-items">${items.slice(0,3).map(i=>`<span class="spot-user-content"><b>★ ${num(i.rating).toFixed(1)}</b> ${escape(i.name)}</span>`).join('')}${items.length>3?`<span>+${items.length-3}</span>`:''}</div>`:''}<button type="button" class="spot-feed-comment-link" data-action="open-comments" data-id="${escape(post.id)}">${spotUi('عرض التعليقات','View comments')} <span data-comment-count="${escape(post.id)}">${count}</span></button><button type="button" class="spot-feed-add-comment" data-action="open-comments" data-id="${escape(post.id)}">${avatar(state.me)}<span>${spotUi('أضف تعليقًا…','Add a comment…')}</span></button></div></article>`}
async function spotLoadCommentCounts(ids){if(!sup||!ids.length)return;try{const {data,error}=await sup.rpc('spot_comment_summary',{p_ids:ids});if(error)throw error;ids.forEach(id=>spotCommentCounts.set(id,0));for(const row of data||[])spotCommentCounts.set(row.post_id,Number(row.total));document.querySelectorAll('[data-comment-count]').forEach(el=>el.textContent=String(spotCommentCounts.get(el.dataset.commentCount)||0))}catch(e){console.warn('Comment counts unavailable',e)}}
function spotCloseComments(){const run=spotComments;if(!run)return;spotCommentDrafts.set(run.post,document.getElementById('spotCommentText')?.value||'');spotComments=null;document.getElementById('spotCommentsLayer')?.remove();if(run.focus?.isConnected)run.focus.focus({preventScroll:true})}
function spotCommentRow(c,run){const author=state.people.find(p=>p.id===c.author_id),post=state.posts.find(p=>p.id===run.post),root=c.parent_id||c.id,replies=run.replies.get(c.id);return `<article class="spot-comment-row ${c.parent_id?'is-reply':''}" data-comment-id="${escape(c.id)}">${avatar(author)}<div class="spot-comment-content"><p class="spot-user-content"><b>${escape(author?.username||spotUi('عضو Spot','Spot member'))}</b>${c.author_id===post?.owner_id?`<em>${spotUi('صاحب المنشور','Author')}</em>`:''}<span>${escape(c.body)}</span></p><div class="spot-comment-meta"><time datetime="${escape(c.created_at)}">${dt(c.created_at)}</time>${state.me?`<button type="button" data-action="reply-comment" data-id="${escape(root)}" data-author="${escape(author?.username||'')}">${spotUi('رد','Reply')}</button>`:''}${state.me&&(c.author_id===state.me.id||post?.owner_id===state.me.id)?`<button type="button" data-action="delete-comment" data-id="${escape(c.id)}">${spotUi('حذف','Delete')}</button>`:''}</div>${!c.parent_id&&Number(c.reply_count)>0?`<button type="button" class="spot-comment-show-replies" data-action="comment-replies" data-id="${escape(c.id)}">${replies?.open?spotUi('إخفاء الردود','Hide replies'):spotUi('عرض الردود','View replies')+' ('+c.reply_count+')'}</button>`:''}${replies?.open?`<div class="spot-comment-replies">${replies.rows.map(r=>spotCommentRow(r,run)).join('')}${replies.more?`<button type="button" data-action="comment-replies-more" data-id="${escape(c.id)}">${spotUi('ردود أخرى','More replies')}</button>`:''}</div>`:''}</div></article>`}
function spotPaintComments(){const run=spotComments,box=document.getElementById('spotCommentList');if(!run||!box)return;const y=box.scrollTop;box.innerHTML=run.error?`<div class="empty-state"><p>${spotUi('تعذّر تحميل التعليقات. حاول مرة ثانية.','Could not load comments. Please retry.')}</p>${btn(spotUi('إعادة المحاولة','Retry'),'comments-retry','outline sm')}</div>`:run.loading&&!run.rows.length?`<p class="spot-comment-empty">${spotUi('جاري تحميل التعليقات…','Loading comments…')}</p>`:run.rows.length?run.rows.map(c=>spotCommentRow(c,run)).join('')+(run.more?btn(spotUi('تعليقات أخرى','More comments'),'comments-more','ghost wide'):''):`<p class="spot-comment-empty">${spotUi('ما في تعليقات بعد. كن أول من يعلّق.','No comments yet. Start the conversation.')}</p>`;box.scrollTop=y}
async function spotFetchCommentPage(parent=null,append=false){const run=spotComments;if(!run||run.loading)return;run.loading=true;run.error=false;const thread=parent?run.replies.get(parent):null,rows=thread?.rows||run.rows,offset=append?rows.length:0;try{const {data,error}=await sup.rpc('spot_comment_page',{p_post:run.post,p_parent:parent,p_offset:offset});if(error)throw error;if(spotComments!==run)return;const incoming=data||[],next=append?[...rows,...incoming.slice(0,20)]:incoming.slice(0,20),unique=[...new Map(next.map(c=>[c.id,c])).values()];if(parent)run.replies.set(parent,{rows:unique,more:incoming.length>20,open:true});else{run.rows=unique;run.more=incoming.length>20}}catch(e){if(spotComments===run){if(parent)alertToast(spotUi('تعذّر تحميل الردود. حاول مجددًا.','Could not load replies. Please retry.'));else run.error=true}}finally{if(spotComments===run){run.loading=false;spotPaintComments()}}}
async function spotOpenComments(id){const post=state.posts.find(p=>p.id===id);if(!post||!spotCanView(post.owner_id))return;spotCloseComments();const run=spotComments={post:id,rows:[],replies:new Map(),reply:null,loading:false,busy:false,focus:document.activeElement};const layer=document.createElement('div');layer.id='spotCommentsLayer';layer.className='spot-comments-layer';layer.innerHTML=`<div class="spot-comments-backdrop" data-action="close-comments"></div><section class="spot-comments-sheet" role="dialog" aria-modal="true" aria-labelledby="spotCommentsTitle"><div class="spot-sheet-handle" aria-hidden="true"></div><header><h2 id="spotCommentsTitle">${spotUi('التعليقات','Comments')} <span data-comment-count="${escape(id)}">${spotCommentCounts.get(id)||0}</span></h2><button type="button" class="modal-close" data-action="close-comments" aria-label="${spotUi('إغلاق التعليقات','Close comments')}">×</button></header><div id="spotCommentList" class="spot-comment-list" aria-live="polite"></div>${state.me?`<form id="spotCommentForm" class="spot-comment-form"><div id="spotCommentReplyTo" class="spot-comment-reply-to" hidden></div><div class="spot-comment-compose">${avatar(state.me)}<textarea id="spotCommentText" rows="1" maxlength="2000" required placeholder="${spotUi('أضف تعليقًا…','Add a comment…')}" aria-label="${spotUi('تعليقك','Your comment')}"></textarea><button type="submit">${spotUi('نشر','Post')}</button></div><p id="spotCommentError" class="spot-comment-error" role="alert" hidden></p></form>`:`<div class="spot-comment-login">${btn(spotUi('سجّل دخولك للتعليق','Sign in to comment'),'comments-login','outline wide')}</div>`}</section>`;document.body.appendChild(layer);const input=document.getElementById('spotCommentText');if(input)input.value=spotCommentDrafts.get(id)||'';layer.querySelector('.modal-close').focus({preventScroll:true});await spotFetchCommentPage();if(spotComments===run)await spotLoadCommentCounts([id])}
function spotSetCommentReply(id,author=''){if(!spotComments)return;spotComments.reply=id||null;const bar=document.getElementById('spotCommentReplyTo');if(bar){bar.hidden=!id;bar.innerHTML=id?`<span>${spotUi('رد على','Replying to')} <b dir="ltr">@${escape(author)}</b></span><button type="button" data-action="cancel-comment-reply" aria-label="${spotUi('إلغاء الرد','Cancel reply')}">×</button>`:''}document.getElementById('spotCommentText')?.focus()}
async function spotSendComment(form){const run=spotComments,input=document.getElementById('spotCommentText'),body=input?.value.trim();if(!run||run.busy||!body||!state.me)return;if(!navigator.onLine)return alertToast(spotUi('اتصل بالإنترنت لنشر تعليقك.','Connect to the internet to post your comment.'));run.busy=true;const parent=run.reply,id=spotUUID(),button=form.querySelector('[type=submit]'),errorBox=document.getElementById('spotCommentError');button.disabled=true;input.disabled=true;errorBox.hidden=true;try{const {error}=await sup.from('spot_post_comments').insert({id,post_id:run.post,author_id:state.me.id,parent_id:parent,body});if(error)throw error;spotCommentDrafts.delete(run.post);if(spotComments!==run)return;input.value='';spotSetCommentReply(null);const row={id,post_id:run.post,author_id:state.me.id,parent_id:parent,body,created_at:new Date().toISOString(),reply_count:0};if(parent){const root=run.rows.find(c=>c.id===parent);if(root)root.reply_count=Number(root.reply_count||0)+1;const thread=run.replies.get(parent);if(thread&&!thread.more)thread.rows.push(row);else if(!thread&&Number(root?.reply_count)===1)run.replies.set(parent,{rows:[row],more:false,open:true})}else{run.rows.unshift(row)}spotPaintComments();await spotLoadCommentCounts([run.post]);alertToast(spotUi('تم نشر تعليقك','Your comment was posted'))}catch(e){if(spotComments===run){errorBox.textContent=spotUi('تعذّر نشر تعليقك. النص محفوظ؛ حاول مرة ثانية.','Could not post. Your text is kept; please retry.');errorBox.hidden=false}}finally{run.busy=false;if(input.isConnected){button.disabled=false;input.disabled=false}}}
async function spotDeleteComment(id){const run=spotComments;if(!run||run.busy||!confirm(spotUi('حذف التعليق وردوده؟','Delete this comment and its replies?')))return;run.busy=true;try{const {data,error}=await sup.from('spot_post_comments').delete().eq('id',id).select('id');if(error||!data?.length)throw error||Error('Not deleted');if(spotComments!==run)return;run.rows=run.rows.filter(c=>c.id!==id);run.replies.delete(id);for(const [parent,thread] of run.replies){const n=thread.rows.length;thread.rows=thread.rows.filter(c=>c.id!==id);if(thread.rows.length<n){const root=run.rows.find(c=>c.id===parent);if(root)root.reply_count=Math.max(0,Number(root.reply_count)-1)}}if(run.reply===id)spotSetCommentReply(null);spotPaintComments();await spotLoadCommentCounts([run.post])}catch(e){alertToast(spotUi('تعذّر حذف التعليق. حاول مجددًا.','Could not delete comment. Please retry.'))}finally{run.busy=false}}
async function spotSharePost(id){const url=new URL(SPOT_PUBLIC_APP_URL);url.searchParams.set('post',id);try{if(navigator.share)await navigator.share({title:'Spot',url:url.href});else{await navigator.clipboard.writeText(url.href);alertToast(spotUi('تم نسخ رابط التجربة','Experience link copied'))}}catch(e){if(e.name!=='AbortError')alertToast(spotUi('تعذّرت المشاركة. حاول مجددًا.','Could not share. Please retry.'))}}
async function spotFeedAction(act,id,el){switch(act){case 'feed-all':case 'feed-following':spotFeedSource=act==='feed-all'?'all':'following';spotFeedLimit=20;render();return true;case 'feed-more':{const y=window.scrollY;spotFeedLimit+=20;render();window.scrollTo({top:y,behavior:'instant'});return true}case 'open-comments':await spotOpenComments(id);return true;case 'close-comments':spotCloseComments();return true;case 'comments-login':spotCloseComments();openModal('login');return true;case 'reply-comment':spotSetCommentReply(id,el.dataset.author);return true;case 'cancel-comment-reply':spotSetCommentReply(null);return true;case 'comments-retry':await spotFetchCommentPage();return true;case 'comments-more':await spotFetchCommentPage(null,true);return true;case 'comment-replies':{const t=spotComments?.replies.get(id);if(t?.open){t.open=false;spotPaintComments()}else if(t){t.open=true;spotPaintComments()}else await spotFetchCommentPage(id);return true}case 'comment-replies-more':await spotFetchCommentPage(id,true);return true;case 'delete-comment':await spotDeleteComment(id);return true;case 'share-post':await spotSharePost(id);return true;default:return false}}
async function spotRefreshComments(){const run=spotComments;if(!run||run.busy||run.loading)return;run.loading=true;try{const count=Math.max(1,Math.ceil(run.rows.length/20)),rows=[];let more=false;for(let page=0;page<count;page++){const {data,error}=await sup.rpc('spot_comment_page',{p_post:run.post,p_parent:null,p_offset:page*20});if(error)throw error;rows.push(...(data||[]).slice(0,20));more=(data||[]).length>20;if(!more)break}if(spotComments!==run)return;run.rows=rows;run.more=more;for(const [parent,thread] of run.replies){if(!run.rows.some(c=>c.id===parent)){run.replies.delete(parent);if(run.reply===parent)spotSetCommentReply(null);continue}if(!thread.open)continue;const loaded=Math.max(1,Math.ceil(thread.rows.length/20)),replies=[];let replyMore=false;for(let page=0;page<loaded;page++){const {data,error}=await sup.rpc('spot_comment_page',{p_post:run.post,p_parent:parent,p_offset:page*20});if(error)throw error;replies.push(...(data||[]).slice(0,20));replyMore=(data||[]).length>20;if(!replyMore)break}if(spotComments!==run)return;thread.rows=replies;thread.more=replyMore}spotPaintComments()}catch(e){console.warn('Comments refresh delayed',e)}finally{run.loading=false}}
function spotOnCommentChange(payload){clearTimeout(spotCommentRefresh);spotCommentRefresh=setTimeout(async()=>{const id=payload.new?.post_id;if(id)await spotLoadCommentCounts([id]);else await spotLoadCommentCounts(state.posts.map(p=>p.id));const run=spotComments;if(!run)return;const post=state.posts.find(p=>p.id===run.post);if(!post||!spotCanView(post.owner_id))return spotCloseComments();if(id&&id!==run.post)return;await spotRefreshComments()},350)}

document.addEventListener('keydown',e=>{const layer=document.getElementById('spotCommentsLayer');if(!layer)return;if(e.key==='Escape'){e.preventDefault();e.stopImmediatePropagation();spotCloseComments()}if(e.key==='Tab'){const nodes=[...layer.querySelectorAll('button:not([disabled]),textarea:not([disabled])')].filter(el=>el.getClientRects().length),first=nodes[0],last=nodes.at(-1);if(e.shiftKey&&document.activeElement===first){e.preventDefault();last?.focus()}else if(!e.shiftKey&&document.activeElement===last){e.preventDefault();first?.focus()}}},true);
