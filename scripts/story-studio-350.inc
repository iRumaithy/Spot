async function spotStartCamera(run=spotComposer){if(!run||spotComposer!==run||run.saving)return;const token=run.cameraToken=spotUUID();spotReleaseCamera(run);const status=$('#spotCameraStatus');if(status){status.classList.remove('hidden');status.innerHTML='<span class="spot-studio-spinner"></span><b>نفتح الكاميرا…</b><small>الصورة تبقى على جهازك حتى تضغط نشر.</small>'}try{if(!navigator.mediaDevices?.getUserMedia)throw Object.assign(Error('camera unsupported'),{name:'NotSupportedError'});const stream=await navigator.mediaDevices.getUserMedia({audio:false,video:{facingMode:{ideal:run.facing},width:{ideal:1920},height:{ideal:1080}}});if(spotComposer!==run||run.cameraToken!==token){spotStopStream(stream);return}run.stream=stream;const video=$('#spotCameraLive');video.srcObject=stream;video.classList.toggle('is-front',run.facing==='user');await Promise.race([video.play(),new Promise((_,reject)=>setTimeout(()=>reject(Error('تعذر بدء معاينة الكاميرا')),9000))]);if(spotComposer!==run){spotStopStream(stream);return}status?.classList.add('hidden')}catch(e){if(spotComposer!==run||run.cameraToken!==token)return;spotReleaseCamera(run);const denied=e.name==='NotAllowedError'||e.name==='SecurityError';if(status){status.classList.remove('hidden');status.innerHTML=`${spotStudioIcon('album')}<b>${denied?'اسمح للكاميرا لالتقاط لحظتك':'الكاميرا المباشرة غير متاحة هنا'}</b><small>${denied?'يمكنك تعديل الإذن من إعدادات المتصفح، أو فتح كاميرا الجهاز.':'استخدم كاميرا الجهاز أو ارفع صورة من الألبوم.'}</small><button type="button" class="spot-story-publish" data-action="native-camera">فتح كاميرا الجهاز</button><button type="button" class="spot-studio-text-button" data-action="camera-retry">إعادة المحاولة</button>`}}}
