async function spotTakePhoto(){const run=spotComposer;if(!run||run.saving||run.capturing)return;if(!run.stream)return $('#spotStoryNativeCamera')?.click();const video=$('#spotCameraLive');if(!video?.videoWidth)return alertToast('انتظر حتى تظهر معاينة الكاميرا');run.capturing=true;const button=$('#spotShutter'),status=$('#spotCameraStatus');button.disabled=true;status.classList.remove('hidden');status.innerHTML='<span class="spot-studio-spinner"></span><b>نجهّز صورتك…</b>';try{const canvas=document.createElement('canvas'),scale=Math.min(1,2048/Math.max(video.videoWidth,video.videoHeight));canvas.width=Math.round(video.videoWidth*scale);canvas.height=Math.round(video.videoHeight*scale);canvas.getContext('2d').drawImage(video,0,0,canvas.width,canvas.height);const blob=await new Promise(resolve=>canvas.toBlob(resolve,'image/jpeg',.94));if(!blob)throw Error('تعذر التقاط الصورة');if(spotComposer!==run)return;await spotSelectStoryFile(new File([blob],'spot-camera-'+Date.now()+'.jpg',{type:'image/jpeg'}),'camera')}catch(e){alertToast(e.message)}finally{run.capturing=false;if(spotComposer===run){button.disabled=false;status.classList.add('hidden')}}}
