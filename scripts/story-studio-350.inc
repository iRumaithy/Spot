function spotVisibleStories(owner){return state.stories.filter(s=>s.owner_id===owner&&Date.parse(s.expires_at)>Date.now()&&spotCanView(owner)).sort((a,b)=>Date.parse(a.created_at)-Date.parse(b.created_at))}
