async function spotStoryAction(act,id,el){switch(act){case 'new-story':await spotNewStory();return true;case 'close-composer':spotCloseComposer();return true;case 'composer-album':if(!spotComposer?.saving&&!spotComposer?.recording)$('#spotStoryAlbum')?.click();return true;case 'native-camera':$('#spotStoryNativeCamera')?.setAttribute('accept',spotComposer?.mode==='video'?'video/*':'image/*,video/*');$('#spotStoryNativeCamera')?.click();return true;case 'camera-retry':await spotStartCamera();return true;case 'camera-flip':if(spotComposer&&!spotComposer.recording&&!spotComposer.preparingRecord){spotComposer.facing=spotComposer.facing==='user'?'environment':'user';await spotStartCamera()}return true;case 'camera-photo-mode':spotCameraMode('photo');return true;case 'camera-video-mode':spotCameraMode('video');return true;case 'camera-shutter':if(spotComposer?.mode==='video')await spotRecordVideo();else await spotTakePhoto();return true;case 'composer-retake':spotRetake();return true;case 'composer-fit':if(spotComposer){spotComposer.fit=spotComposer.fit==='contain'?'cover':'contain';const media=$('.spot-composer-preview');if(media)media.style.objectFit=spotComposer.fit;el.setAttribute('aria-label',spotComposer.fit==='contain'?'عرض الصورة كاملة':'ملء إطار الستوري')}return true;case 'open-stories':await spotOpenStories(id);return true;case 'close-story':spotCloseStory();return true;case 'next-story':await spotMoveStory(1);return true;case 'previous-story':await spotMoveStory(-1);return true;case 'story-jump':if(spotStorySession){const i=Number(el.dataset.index);if(Number.isInteger(i)&&i>=0&&i<spotStorySession.rows.length){spotStorySession.index=i;await spotDrawStory()}}return true;case 'pause-story':if(spotStorySession){const paused=spotStorySession.reasons.has('user')||spotStorySession.reasons.has('play-required');spotStorySession.reasons.delete('play-required');spotSetPause('user',!paused)}return true;case 'story-sound':spotStoryMuted=!spotStoryMuted;{const video=$('#spot