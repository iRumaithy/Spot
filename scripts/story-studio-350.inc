function spotCloseComposer(force=false){const run=spotComposer;if(!run)return true;if(run.saving&&!force){alertToast('انتظر اكتمال رفع الستوري');return false}spotComposer=null;clearInterval(run.recordTimer);clearTimeout(run.recordLimit);if(run.recorder?.state==='recording'){run.discardRecording=true;try{run.recorder.stop()}catch{}}spotReleaseCamera(run);if(run.previewURL)URL.revokeObjectURL(run.previewURL);$('#spotStoryComposer')?.remove();document.body.classList.remove('spot-story-open');return true}
