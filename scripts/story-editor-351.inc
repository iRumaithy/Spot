const spotOverlayColors=['#ffffff','#ffdc85','#ffc1cc','#b9edc8','#111d17'];
const spotOverlayStickers=['☕','🍵','🍰','🍔','🍕','🍣','🍦','✨','🔥','🤍','😍','👌','📍','🌅','🎉','🇦🇪'];
function spotCleanOverlays(value){
 if(!Array.isArray(value))return [];
 const number=(v,f,min,max)=>typeof v==='number'&&Number.isFinite(v)?Math.max(min,Math.min(max,v)):f;
 return value.slice(0,12).filter(o=>o&&['text','sticker','clock','date'].includes(o.kind)&&typeof o.text==='string'&&o.text.trim()).map((o,i)=>({id:String(o.id||i).replace(/[^a-zA-Z0-9-]/g,'').slice(0,40)||String(i),kind:o.kind,text:o.text.slice(0,120),x:number(o.x,.5,.04,.96),y:number(o.y,.5,.06,.94),scale:number(o.scale,1,.55,2),rotation:number(o.rotation,0,-30,30),color:spotOverlayColors.includes(o.color)?o.color:'#ffffff',background:['none','dark','light'].includes(o.background)?o.background:'none'}));
}
function spotOverlayMarkup(rows,editing=false,selected=''){
 return spotCleanOverlays(rows).map(o=>`<${editing?'button type="button"':'span'} dir="auto" class="spot-story-decoration ${o.kind==='sticker'?'is-sticker':''} ${selected===o.id?'is-selected':''} bg-${o.background}" ${editing?`data-overlay-id="${escape(o.id)}" aria-label="تحريك ${escape(o.text)}"`:''} style="left:${o.x*100}%;top:${o.y*100}%;--decoration-scale:${o.scale};--decoration-angle:${o.rotation}deg;color:${o.color}">${escape(o.text)}</${editing?'button':'span'}>`).join('');
}
function spotStoryCanvas(stage,media,rows=[],editing=false){
 stage.querySelector('.spot-story-canvas')?.remove();const canvas=document.createElement('div');canvas.className='spot-story-canvas';const layer=document.createElement('div');layer.className='spot-story-decorations'+(editing?' is-editable':'');layer.innerHTML=spotOverlayMarkup(rows,editing,spotComposer?.selectedOverlay);canvas.append(media,layer);stage.appendChild(canvas);
 const layout=()=>{const width=Math.min(stage.clientWidth,stage.clientHeight*9/16);canvas.style.width=width+'px';canvas.style.height=width*16/9+'px';canvas.style.setProperty('--story-unit',width/360+'px')};layout();const observer=new ResizeObserver(layout);observer.observe(stage);
 if(editing)spotBindOverlayDrag(layer,canvas);return {canvas,layer,observer};
}
function spotPaintOverlays(){const run=spotComposer;if(!run?.composition)return;run.composition.layer.innerHTML=spotOverlayMarkup(run.overlays,true,run.selectedOverlay)}
function spotOverlayTools(){return `<div class="spot-overlay-tools hidden" id="spotOverlayTools"><div class="spot-overlay-toolbar" role="group" aria-label="تعديل الستوري"><button type="button" data-action="overlay-text"><b>Aa</b> نص</button><button type="button" data-action="overlay-stickers">✦ ستيكر</button><button type="button" data-action="overlay-clock">◷ ساعة</button><button type="button" data-action="overlay-date">▦ تاريخ</button></div><div id="spotOverlayPanel"></div><p class="spot-overlay-hint">اسحب العنصر لمكانه · اضغط عليه لتعديله</p></div>`}
function spotAddOverlay(kind,text){const run=spotComposer;if(!run?.file||run.saving)return;if(run.overlays.length>=12)return alertToast('يمكن إضافة 12 عنصرًا لكل ستوري');const id=spotUUID();run.overlays.push({id,kind,text,x:.5,y:.24+(run.overlays.length%5)*.13,scale:kind==='sticker'?1.35:1,rotation:0,color:'#ffffff',background:kind==='clock'||kind==='date'?'dark':'none'});run.selectedOverlay=id;spotPaintOverlays();spotShowOverlayPanel();if(kind==='text')$('#spotOverlayText')?.focus()}
function spotShowOverlayPanel(stickers=false){
 const run=spotComposer,panel=$('#spotOverlayPanel');if(!run||!panel)return;
 if(stickers){panel.innerHTML=`<div class="spot-sticker-picker" role="group" aria-label="اختيار ستيكر">${spotOverlayStickers.map((x,i)=>`<button type="button" data-action="overlay-pick-sticker" data-id="${i}" aria-label="إضافة ستيكر ${x}">${x}</button>`).join('')}</div><button type="button" data-action="overlay-done" class="spot-overlay-done">تم</button>`;return}
 const o=run.overlays.find(x=>x.id===run.selectedOverlay);if(!o){panel.innerHTML='';return}
 panel.innerHTML=`<div class="spot-overlay-panel"><div class="spot-overlay-edit-row">${o.kind==='text'?`<input id="spotOverlayText" aria-label="نص على الستوري" maxlength="120" value="${escape(o.text)}" placeholder="اكتب نصك…" dir="auto">`:`<strong>${escape(o.text)}</strong>`}<button type="button" data-action="overlay-delete" aria-label="حذف العنصر المحدد">حذف</button><button type="button" data-action="overlay-done" aria-label="إنهاء تعديل العنصر">تم</button></div><div class="spot-overlay-edit-row"><label>الحجم <input id="spotOverlayScale" aria-label="حجم العنصر" type="range" min="0.55" max="2" step="0.05" value="${o.scale}"></label><label>الميل <input id="spotOverlayAngle" aria-label="ميل العنصر" type="range" min="-30" max="30" step="1" value="${o.rotation}"></label></div>${o.kind!=='sticker'?`<div class="spot-overlay-edit-row"><div class="spot-overlay-colors" role="group" aria-label="لون النص">${spotOverlayColors.map((color,i)=>`<button type="button" data-action="overlay-color" data-id="${i}" aria-label="لون النص ${['أبيض','ذهبي','وردي','نعناعي','داكن'][i]}" aria-pressed="${o.color===color}" style="background:${color}"></button>`).join('')}</div><button type="button" data-action="overlay-background" aria-label="تغيير خلفية النص">خلفية ${o.background==='none'?'شفافة':o.background==='dark'?'داكنة':'فاتحة'}</button></div>`:''}</div>`;
}
function spotBindOverlayDrag(layer,canvas){
 let drag=null;layer.addEventListener('pointerdown',e=>{const button=e.target.closest('[data-overlay-id]'),run=spotComposer;if(!button||!run||run.saving||!e.isPrimary)return;e.preventDefault();e.stopPropagation();const o=run.overlays.find(x=>x.id===button.dataset.overlayId);if(!o)return;run.selectedOverlay=o.id;layer.querySelectorAll('.is-selected').forEach(x=>x.classList.remove('is-selected'));button.classList.add('is-selected');spotShowOverlayPanel();const rect=canvas.getBoundingClientRect();drag={o,button,x:e.clientX,y:e.clientY,ox:o.x,oy:o.y,rect};layer.setPointerCapture(e.pointerId)});
 layer.addEventListener('pointermove',e=>{if(!drag)return;e.preventDefault();const d=drag,halfW=Math.min(.46,d.button.getBoundingClientRect().width/d.rect.width/2),halfH=Math.min(.44,d.button.getBoundingClientRect().height/d.rect.height/2);d.o.x=Math.max(halfW,Math.min(1-halfW,d.ox+(e.clientX-d.x)/d.rect.width));d.o.y=Math.max(.06+halfH,Math.min(.94-halfH,d.oy+(e.clientY-d.y)/d.rect.height));d.button.style.left=d.o.x*100+'%';d.button.style.top=d.o.y*100+'%'});
 const finish=()=>{drag=null};layer.addEventListener('pointerup',finish);layer.addEventListener('pointercancel',finish);layer.addEventListener('lostpointercapture',finish);
 layer.addEventListener('keydown',e=>{const target=e.target.closest('[data-overlay-id]'),run=spotComposer;if(!target||!run||run.saving)return;const o=run.overlays.find(x=>x.id===target.dataset.overlayId),step=e.shiftKey ? .06 : .02;if(!o||!['ArrowLeft','ArrowRight','ArrowUp','ArrowDown'].includes(e.key))return;e.preventDefault();if(e.key==='ArrowLeft')o.x=Math.max(.08,o.x-step);if(e.key==='ArrowRight')o.x=Math.min(.92,o.x+step);if(e.key==='ArrowUp')o.y=Math.max(.12,o.y-step);if(e.key==='ArrowDown')o.y=Math.min(.88,o.y+step);target.style.left=o.x*100+'%';target.style.top=o.y*100+'%'});
}
async function spotPrepareStoryImage(file){const image=await spotValidateStoryImage(file),ratio=Math.min(1,2048/Math.max(image.naturalWidth,image.naturalHeight));if(ratio===1&&file.size<1500000)return file;const canvas=document.createElement('canvas');canvas.width=Math.round(image.naturalWidth*ratio);canvas.height=Math.round(image.naturalHeight*ratio);canvas.getContext('2d').drawImage(image,0,0,canvas.width,canvas.height);const type=file.type==='image/png'?'image/png':file.type==='image/webp'?'image/webp':'image/jpeg',blob=await new Promise(resolve=>canvas.toBlob(resolve,type,.88));if(!blob)throw Error('تعذر تجهيز الصورة');return new File([blob],'spot-optimized.'+({'image/png':'png','image/webp':'webp','image/jpeg':'jpg'}[blob.type]||'jpg'),{type:blob.type})}
function spotHandleOverlayAction(act,id){
 const run=spotComposer;if(!run||!act.startsWith('overlay-'))return false;if(run.saving)return true;const o=run.overlays.find(x=>x.id===run.selectedOverlay);
 switch(act){case 'overlay-text':spotAddOverlay('text','لحظتي ✨');break;case 'overlay-stickers':spotShowOverlayPanel(true);break;case 'overlay-pick-sticker':if(spotOverlayStickers[Number(id)])spotAddOverlay('sticker',spotOverlayStickers[Number(id)]);break;case 'overlay-clock':spotAddOverlay('clock',new Date().toLocaleTimeString('ar-AE',{hour:'numeric',minute:'2-digit',hour12:true}));break;case 'overlay-date':spotAddOverlay('date',new Date().toLocaleDateString('ar-AE',{day:'numeric',month:'long',year:'numeric'}));break;case 'overlay-delete':run.overlays=run.overlays.filter(x=>x.id!==run.selectedOverlay);run.selectedOverlay='';spotPaintOverlays();spotShowOverlayPanel();break;case 'overlay-done':run.selectedOverlay='';spotPaintOverlays();spotShowOverlayPanel();break;case 'overlay-color':if(o&&spotOverlayColors[Number(id)])o.color=spotOverlayColors[Number(id)];spotPaintOverlays();spotShowOverlayPanel();break;case 'overlay-background':if(o)o.background=['none','dark','light'][(['none','dark','light'].indexOf(o.background)+1)%3];spotPaintOverlays();spotShowOverlayPanel();break;default:return false}return true;
}
document.addEventListener('input',e=>{const run=spotComposer,o=run?.overlays?.find(x=>x.id===run.selectedOverlay);if(!o||run.saving)return;if(e.target.id==='spotOverlayText')o.text=e.target.value.slice(0,120);else if(e.target.id==='spotOverlayScale')o.scale=Number(e.target.value);else if(e.target.id==='spotOverlayAngle')o.rotation=Number(e.target.value);else return;spotPaintOverlays()});
