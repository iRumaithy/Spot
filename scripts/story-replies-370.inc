// Direct replies carry a private, immutable thumbnail and server-derived story context.
const spotStoryReplyDrafts=new Map(),spotStoryReplyAttempts=new Map(),spotDmStoryPreviews=new Map();
function spotStoryReplyForm(story){if(!state.me||story.owner_id===state.me.id)return '';return `<form id="spotStoryReplyForm" class="spot-story-reply-form" data-story="${escape(story.id)}"><div class="spot-story-reply-compose"><textarea id="spotStoryReplyText" rows="1" maxlength="2000" data-story="${escape(story.id)}" aria-label="${spotUi('رد على الستوري','Reply to story')}" placeholder="${spotUi('رد على الستوري…','Reply to story…')}" required>${escape(spotStoryReplyDrafts.get(story.id)||'')}</textarea><button type="submit" aria-label="${spotUi('إرسال الرد بالخاص','Send private reply')}">${ico('share',21)}</button><button type="button" data-action="cancel-story-reply" aria-label="${spotUi('إلغاء الرد','Cancel reply')}" class="spot-story-reply-cancel">×</button></div><p id="spotStoryReplyStatus" role="status" hidden></p></form>`}
function spotRememberStoryReply(){const input=document.getElementById('spotStoryReplyText');if(input?.dataset.story)spotStoryReplyDrafts.set(input.dataset.story,input.value)}
function spotCancelStoryReply(){const input=document.getElementById('spotStoryReplyText');if(!input||spotStorySession?.replyBusy)return;input.value='';spotStoryReplyDrafts.delete(input.dataset.story);spotStoryReplyAttempts.delete(input.dataset.story);input.blur();spotSetPause('reply',false);document.querySelector('#spotStoryViewer [data-action="pause-story"]')?.focus({preventScroll:true});spotStoryReplyViewport()}
function spotStoryReplyViewport(){const viewer=document.getElementById('spotStoryViewer');if(!viewer)return;const active=!!document.getElementById('spotStoryReplyForm')?.contains(document.activeElement);viewer.classList.toggle('is-replying',active);if(active&&window.visualViewport){viewer.style.setProperty('--spot-story-viewport-height',window.visualViewport.height+'px');viewer.style.setProperty('--spot-story-viewport-top',window.visualViewport.offsetTop+'px')}}
async function spotStoryReplyThumbnail(media,story){const w=media.tagName==='VIDEO'?media.videoWidth:media.naturalWidth,h=media.tagName==='VIDEO'?media.videoHeight:media.naturalHeight;if(!w||!h)throw Error('Story media not ready');const canvas=document.createElement('canvas');canvas.width=180;canvas.height=320;const ctx=canvas.getContext('2d');ctx.fillStyle='#15251e';ctx.fillRect(0,0,180,320);const fit=story.fit_mode==='cover'?Math.max(180/w,320/h):Math.min(180/w,320/h);ctx.drawImage(media,(180-w*fit)/2,(320-h*fit)/2,w*fit,h*fit);const blob=await new Promise(resolve=>canvas.toBlob(resolve,'image/jpeg',.78));if(!blob||blob.size>262144)throw Error('Thumbnail unavailable');return blob}
async function spotSendStoryReply(form){const run=spotStorySession,input=document.getElementById('spotStoryReplyText'),story=state.stories.find(s=>s.id===form.dataset.story),body=input?.value.trim(),actor=state.me?.id;if(!actor||!run||run.replyBusy||!story||story.owner_id===actor)return;if(!body||body.length>2000)return;if(!navigator.onLine)return alertToast(spotUi('اتصل بالإنترنت لإرسال الرد.','Connect to the internet to reply.'));if(!run.loaded)return alertToast(spotUi('انتظر تحميل الستوري قبل الرد.','Wait for the story to load before replying.'));if(Date.parse(story.expires_at)<=Date.now()||!spotCanView(story.owner_id))return alertToast(spotUi('الستوري لم تعد متاحة.','This story is no longer available.'));const button=form.querySelector('[type=submit]'),status=document.getElementById('spotStoryReplyStatus');run.replyBusy=true;spotSetPause('reply-send',true);button.disabled=true;input.disabled=true;status.hidden=true;spotStoryReplyDrafts.set(story.id,body);
try{let attempt=spotStoryReplyAttempts.get(story.id);if(!attempt||attempt.body!==body||attempt.actor!==actor){const id=spotUUID();attempt={id,body,actor,path:actor+'/'+id+'.jpg',uploaded:false};spotStoryReplyAttempts.set(story.id,attempt)}if(!attempt.uploaded){const media=document.querySelector('#spotStoryMedia .spot-story-canvas>img,#spotStoryMedia .spot-story-canvas>video');if(!media)throw Error('Story media unavailable');const thumbnail=await spotStoryReplyThumbnail(media,story);if(state.me?.id!==actor)throw Error('Session changed');const {error}=await sup.storage.from('spot-dm-previews').upload(attempt.path,thumbnail,{contentType:'image/jpeg',upsert:false});if(error&&String(error.statusCode)!=='409'&&error.status!==409)throw error;attempt.uploaded=true}if(state.me?.id!==actor)throw Error('Session changed');const payload={id:attempt.id,sender_id:actor,recipient_id:story.owner_id,body,story_id:story.id,story_preview_path:attempt.path};const {error}=await sup.from('spot_direct_messages').insert(payload).select('id').single();if(error){const check=await sup.from('spot_direct_messages').select('id').eq('id',attempt.id).eq('sender_id',actor).eq('recipient_id',story.owner_id).maybeSingle();if(check.error||!check.data)throw error}spotStoryReplyDrafts.delete(story.id);spotStoryReplyAttempts.delete(story.id);if(state.me?.id!==actor)return;if(input.isConnected&&input.dataset.story===story.id){input.value='';input.blur();status.textContent=spotUi('تم إرسال الرد بالخاص ✓','Private reply sent ✓');status.hidden=false;spotSetPause('reply',false);spotStoryReplyViewport()}await spotLoadMessages();updateHeader();alertToast(spotUi('تم إرسال ردّك بالخاص مع معاينة الستوري','Your private reply and story preview were sent'))}catch(e){if(input.isConnected){status.textContent=spotUi('تعذّر إرسال الرد. النص محفوظ؛ حاول مرة ثانية.','Could not send. Your text is kept; please retry.');status.hidden=false;spotSetPause('reply',true)}}finally{run.replyBusy=false;if(spotStorySession===run)spotSetPause('reply-send',false);if(input.isConnected){button.disabled=false;input.disabled=false}}}
function spotDmStoryContext(message){if(!message.story_id||!message.story_preview_path)return '';const context=message.story_context||{},preview=spotDmStoryPreviews.get(message.story_preview_path),label=message.sender_id===state.me?.id?spotUi('رددت على الستوري','You replied to a story'):spotUi('ردّ على قصتك','Replied to your story');return `<button type="button" class="spot-dm-story-context" data-action="open-dm-story" data-id="${escape(message.id)}" aria-label="${escape(label)}"><span class="spot-dm-story-thumb">${ico('camera',19)}${preview?.url?`<img src="${escape(preview.url)}" alt="${spotUi('صورة مصغرة للستوري','Story thumbnail')}" loading="lazy" onerror="this.hidden=true">`:''}${context.media_type==='video'?'<i aria-hidden="true">▶</i>':''}</span><span><b>${label}</b><small class="spot-user-content">${escape(context.caption||spotUi(context.media_type==='video'?'ستوري فيديو':'ستوري صورة',context.media_type==='video'?'Video story':'Photo story'))}</small></span></button>`}
async function spotResolveDmStoryPreviews(){const actor=state.me?.id;if(!actor)return;const paths=[...new Set(state.dmMessages.map(m=>m.story_preview_path).filter(Boolean))].filter(path=>!spotDmStoryPreviews.has(path)||spotDmStoryPreviews.get(path).until<Date.now()+15000);if(!paths.length)return;try{const {data,error}=await sup.storage.from('spot-dm-previews').createSignedUrls(paths,90);if(error)throw error;if(state.me?.id!==actor)return;for(const row of data||[])if(row.signedUrl)spotDmStoryPreviews.set(row.path,{url:row.signedUrl,until:Date.now()+85000});document.querySelectorAll('.spot-dm-story-context[data-id]').forEach(el=>{const message=state.dmMessages.find(m=>m.id===el.dataset.id);if(message)el.outerHTML=spotDmStoryContext(message)})}catch(e){console.warn('Story reply thumbnails delayed',e)}}
async function spotOpenDmStory(id){const message=state.dmMessages.find(m=>m.id===id&&(m.sender_id===state.me?.id||m.recipient_id===state.me?.id));if(!message?.story_id)return;await spotLoadStories();const story=state.stories.find(s=>s.id===message.story_id&&Date.parse(s.expires_at)>Date.now());if(!story||!spotCanView(story.owner_id))return alertToast(spotUi('انتهت الستوري أو لم تعد متاحة؛ تبقى المعاينة في المحادثة.','Story expired or unavailable. Its preview remains in this conversation.'));await spotOpenStories(story.owner_id,story.id)}
function spotClearStoryReplyState(){spotStoryReplyDrafts.clear();spotStoryReplyAttempts.clear();spotDmStoryPreviews.clear()}
document.addEventListener('input',e=>{if(e.target.id!=='spotStoryReplyText')return;spotRememberStoryReply();spotSetPause('reply',!!e.target.value.trim()||document.activeElement===e.target)});
document.addEventListener('focusin',e=>{if(e.target.closest?.('#spotStoryReplyForm')){if(e.target.id==='spotStoryReplyText')spotSetPause('reply',true);spotStoryReplyViewport()}});
document.addEventListener('focusout',e=>{if(e.target.id==='spotStoryReplyText'){spotRememberStoryReply();if(!e.target.value.trim()&&!spotStorySession?.replyBusy)spotSetPause('reply',false);requestAnimationFrame(spotStoryReplyViewport)}});
window.visualViewport?.addEventListener('resize',spotStoryReplyViewport);window.visualViewport?.addEventListener('scroll',spotStoryReplyViewport);
setInterval(()=>{if(state.me&&!document.hidden)spotResolveDmStoryPreviews()},60000);
