let spotEmojiPromise=null;
function spotLoadEmojiCatalog(){if(window.SPOT_EMOJI_CATALOG)return Promise.resolve(window.SPOT_EMOJI_CATALOG);if(spotEmojiPromise)return spotEmojiPromise;spotEmojiPromise=new Promise((resolve,reject)=>{const script=document.createElement('script');script.src=new URL('spot-emoji-18.js?v=studio3521',location.href).href;script.onload=()=>window.SPOT_EMOJI_CATALOG?resolve(window.SPOT_EMOJI_CATALOG):reject(Error('Emoji catalog missing'));script.onerror=()=>{script.remove();spotEmojiPromise=null;reject(Error('Emoji catalog unavailable'))};document.head.appendChild(script)});return spotEmojiPromise}
function spotOverlayTools(){return `<div class="spot-overlay-tools spot-editor-dock hidden" id="spotOverlayTools"><div class="spot-overlay-toolbar" role="group" aria-label="أدوات الستوري"><button type="button" data-action="overlay-text" aria-label="إضافة نص"><b>Aa</b><small>نص</small></button><button type="button" data-action="overlay-stickers" aria-label="جميع الإيموجيات"><b>☺</b><small>إيموجي</small></button><button type="button" data-action="overlay-draw" aria-label="الرسم بالإصبع" aria-pressed="false"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m4 16 12-12 4 4L8 20H4v-4Zm10-10 4 4"/></svg><small>رسم</small></button><button type="button" data-action="overlay-clock" aria-label="إضافة ساعة"><b>◷</b><small>ساعة</small></button><button type="button" data-action="overlay-date" aria-label="إضافة تاريخ"><b>▦</b><small>تاريخ</small></button></div><div id="spotOverlayPanel"></div><p class="spot-overlay-hint">اضغط على الصورة للكتابة · اسحب العناصر لترتيبها</p></div>`}
function spotEditorSheet(title,body){return `<section class="spot-editor-sheet" aria-label="${escape(title)}"><header><b>${escape(title)}</b><button type="button" data-action="overlay-done" aria-label="إغلاق أدوات التعديل">تم ✓</button></header>${body}</section>`}
function spotShowOverlayPanel(stickers=false){
 const run=spotComposer,panel=$('#spotOverlayPanel');if(!run||!panel)return;
 if(stickers){spotOpenEmoji();return}if(run.drawingMode){spotDrawPanel();return}
 spotLegacyOverlayPanel(false);if(panel.innerHTML)panel.innerHTML=spotEditorSheet('عدّل العنصر',panel.innerHTML);
}
function spotAddOverlay(kind,text,x=null,y=null){const run=spotComposer;if(!run||run.saving)return;spotSetDrawing(false);run.overlays=run.overlays.filter(o=>o.kind!=='text'||o.text.trim());const before=run.overlays.length;spotLegacyAddOverlay(kind,text);if(run.overlays.length>before&&Number.isFinite(x)&&Number.isFinite(y)){const o=run.overlays.at(-1);o.x=Math.max(.08,Math.min(.92,x));o.y=Math.max(.12,Math.min(.88,y));spotPaintOverlays()}if(kind==='text')$('#spotOverlayText')?.focus()}
function spotBeginTextAt(x=.5,y=.3){spotAddOverlay('text','',x,y)}
async function spotOpenEmoji(){
 const run=spotComposer,panel=$('#spotOverlayPanel');if(!run||!panel)return;spotSetDrawing(false);run.selectedOverlay='';spotPaintOverlays();run.emojiSearch='';run.emojiGroup=-1;run.emojiLimit=96;
 panel.innerHTML=spotEditorSheet('كل الإيموجيات',`<div class="spot-emoji-search"><input id="spotEmojiSearch" type="search" placeholder="ابحث عن إيموجي…" aria-label="البحث عن إيموجي" dir="auto"><input id="spotCustomEmoji" placeholder="أو من لوحة مفاتيحك" aria-label="إيموجي من لوحة المفاتيح" maxlength="120" dir="auto"><button type="button" data-action="overlay-custom-emoji">إضافة</button></div><nav class="spot-emoji-categories" aria-label="تصنيفات الإيموجي"><button type="button" data-action="overlay-emoji-group" data-id="-1" aria-pressed="true">الكل</button>${spotEmojiGroups.map(([icon,name],i)=>`<button type="button" data-action="overlay-emoji-group" data-id="${i}" aria-label="${name}" aria-pressed="false">${icon}</button>`).join('')}</nav><div id="spotEmojiResults" class="spot-emoji-results" role="region" aria-label="نتائج الإيموجي"><p>نجهّز مكتبة الإيموجي…</p></div><div id="spotEmojiMore"></div><small id="spotEmojiCount" role="status"></small>`);
 try{await spotLoadEmojiCatalog();if(spotComposer===run&&$('#spotEmojiResults'))spotRenderEmoji()}catch{if(spotComposer===run&&$('#spotEmojiResults'))$('#spotEmojiResults').innerHTML='<p>تعذر تحميل المكتبة. يمكنك استخدام لوحة مفاتيحك، أو '+btn('إعادة المحاولة','overlay-stickers','outline sm')+'</p>'}
}
function spotEmojiMatches(row,query,group){const q=String(query||'').trim().toLocaleLowerCase();return (group<0||row[2]===group)&&(!q||(row[0]+' '+row[1]+' '+row[3]+' '+row[4]+' '+spotEmojiGroups[row[2]]?.[1]).toLocaleLowerCase().includes(q))}
function spotRenderEmoji(){const run=spotComposer,root=$('#spotEmojiResults'),catalog=window.SPOT_EMOJI_CATALOG;if(!run||!root||!catalog)return;const found=catalog.emoji.map((row,i)=>({row,i})).filter(({row})=>spotEmojiMatches(row,run.emojiSearch,run.emojiGroup));root.innerHTML=`<div class="spot-emoji-grid">${found.slice(0,run.emojiLimit).map(({row,i})=>`<button type="button" data-action="overlay-emoji-pick" data-id="${i}" title="${escape(row[3]?.split(' ').slice(0,6).join(' ')||row[1])}" aria-label="إضافة ${escape(row[0])}">${row[0]}</button>`).join('')}</div>`;if(!found.length)root.innerHTML='<p>لم نجد إيموجي بهذا الاسم. جرّب كلمة أخرى أو لوحة مفاتيحك.</p>';$('#spotEmojiMore').innerHTML=found.length>run.emojiLimit?'<button type="button" data-action="overlay-emoji-more">عرض المزيد</button>':'';$('#spotEmojiCount').textContent=`${found.length} من ${catalog.emoji.length} إيموجي`;$$('[data-action="overlay-emoji-group"]').forEach(b=>b.setAttribute('aria-pressed',String(Number(b.dataset.id)===run.emojiGroup)))}
function spotCleanDrawings(value){if(!Array.isArray(value))return [];let remaining=20000;return value.slice(0,50).flatMap((s,i)=>{if(!s||!Array.isArray(s.points)||remaining<1)return [];const points=s.points.slice(0,Math.min(400,remaining)).filter(p=>Array.isArray(p)&&p.length>=2&&p.slice(0,2).every(n=>typeof n==='number'&&Number.isFinite(n))).map(p=>p.slice(0,2).map(n=>Math.round(Math.max(0,Math.min(1,n))*10000)/10000));remaining-=points.length;if(!points.length)return [];return [{id:String(s.id||i).replace(/[^a-zA-Z0-9-]/g,'').slice(0,40),color:spotDrawColors.includes(s.color)?s.color:'#ffffff',width:typeof s.width==='number'&&Number.isFinite(s.width)?Math.max(2,Math.min(28,s.width)):6,opacity:s.opacity===.4?.4:1,points}]})}
function spotDrawingPath(points){if(!points.length)return '';const p=points.map(([x,y])=>`${+(x*360).toFixed(2)} ${+(y*640).toFixed(2)}`);return 'M'+p[0]+(p.length>1?' L'+p.slice(1).join(' L'):' l.01 0')}
function spotDrawingMarkup(rows){return spotCleanDrawings(rows).map(s=>`<path d="${spotDrawingPath(s.points)}" fill="none" stroke="${s.color}" stroke-width="${s.width}" opacity="${s.opacity}" stroke-linecap="round" stroke-linejoin="round"/>`).join('')}
function spotStoryCanvas(stage,media,rows=[],editing=false,drawings=[]){
 stage.querySelector('.spot-story-canvas')?.remove();const canvas=document.createElement('div');canvas.className='spot-story-canvas';const drawing=document.createElementNS('http://www.w3.org/2000/svg','svg');drawing.setAttribute('viewBox','0 0 360 640');drawing.setAttribute('class','spot-story-drawing');drawing.setAttribute('aria-hidden','true');drawing.innerHTML=spotDrawingMarkup(drawings);
 const layer=document.createElement('div');layer.className='spot-story-decorations'+(editing?' is-editable':'');layer.innerHTML=spotOverlayMarkup(rows,editing,spotComposer?.selectedOverlay);canvas.append(media,drawing,layer);stage.appendChild(canvas);
 const layout=()=>{const width=Math.min(stage.clientWidth,stage.clientHeight*9/16);canvas.style.width=width+'px';canvas.style.height=width*16/9+'px';canvas.style.setProperty('--story-unit',width/360+'px')};layout();const observer=new ResizeObserver(layout);observer.observe(stage);
 if(editing){canvas.tabIndex=0;canvas.setAttribute('role','group');canvas.setAttribute('aria-label','معاينة الستوري، اضغط للكتابة');spotBindOverlayDrag(layer,canvas);spotBindCanvasText(canvas,media);spotBindDrawing(drawing,canvas)}return {canvas,layer,observer,drawing};
}
function spotBindCanvasText(canvas,media){let down=null;canvas.addEventListener('pointerdown',e=>{if(spotComposer?.drawingMode||!e.isPrimary||e.target.closest('button'))return;const rect=canvas.getBoundingClientRect();if(media.tagName==='VIDEO'&&e.clientY>rect.bottom-40)return;down={id:e.pointerId,x:e.clientX,y:e.clientY,at:performance.now()}});canvas.addEventListener('pointerup',e=>{const p=down;down=null;if(!p||p.id!==e.pointerId||!spotComposer||spotComposer.drawingMode||spotComposer.saving||Math.hypot(e.clientX-p.x,e.clientY-p.y)>10||performance.now()-p.at>500)return;const r=canvas.getBoundingClientRect();spotBeginTextAt((e.clientX-r.left)/r.width,(e.clientY-r.top)/r.height)});canvas.addEventListener('pointercancel',()=>down=null);canvas.addEventListener('keydown',e=>{if(e.target===canvas&&e.key==='Enter'){e.preventDefault();spotBeginTextAt()}})}
function spotSetDrawing(on){const run=spotComposer;if(!run)return;run.drawingMode=on;run.composition?.canvas.classList.toggle('is-drawing',on);$('#spotOverlayTools [data-action="overlay-draw"]')?.setAttribute('aria-pressed',String(on));if(on){run.selectedOverlay='';spotPaintOverlays()}}
function spotPaintDrawing(){const run=spotComposer;if(run?.composition?.drawing)run.composition.drawing.innerHTML=spotDrawingMarkup(run.drawings)}
function spotDrawSnapshot(run){run.drawUndo.push(run.drawings);if(run.drawUndo.length>25)run.drawUndo.shift();run.drawRedo=[]}
function spotDrawPanel(){const run=spotComposer;if(!run)return;$('#spotOverlayPanel').innerHTML=spotEditorSheet('ارسم بإصبعك',`<div class="spot-draw-tools"><button type="button" data-action="overlay-pen" aria-pressed="${run.brush.tool==='pen'}">قلم</button><button type="button" data-action="overlay-marker" aria-pressed="${run.brush.tool==='marker'}">تحديد</button><button type="button" data-action="overlay-eraser" aria-pressed="${run.brush.tool==='eraser'}">ممحاة</button><label>السُمك <input id="spotBrushWidth" type="range" min="2" max="28" step="1" value="${run.brush.width}" aria-label="سمك القلم"></label></div><div class="spot-draw-colors" role="group" aria-label="ألوان الرسم">${spotDrawColors.map((color,i)=>`<button type="button" data-action="overlay-brush-color" data-id="${i}" aria-label="لون الرسم ${['أبيض','ذهبي','وردي','نعناعي','أزرق','بنفسجي','برتقالي','أسود'][i]}" aria-pressed="${run.brush.color===color}" style="background:${color}"></button>`).join('')}</div><div class="spot-draw-history"><button type="button" data-action="overlay-draw-undo" ${run.drawUndo.length?'':'disabled'}>تراجع</button><button type="button" data-action="overlay-draw-redo" ${run.drawRedo.length?'':'disabled'}>إعادة</button><button type="button" data-action="overlay-draw-clear" ${run.drawings.length?'':'disabled'}>مسح الرسم</button></div>`)}
function spotStrokeDistance(point,stroke){let result=Infinity;const [px,py]=[point[0]*360,point[1]*640];for(let i=0;i<stroke.points.length;i++){const a=stroke.points[Math.max(0,i-1)],b=stroke.points[i],ax=a[0]*360,ay=a[1]*640,dx=b[0]*360-ax,dy=b[1]*640-ay,t=Math.max(0,Math.min(1,((px-ax)*dx+(py-ay)*dy)/(dx*dx+dy*dy||1)));result=Math.min(result,Math.hypot(px-ax-t*dx,py-ay-t*dy))}return result}
function spotBindDrawing(svg,canvas){let stroke=null,draft=null,origin=null,id=null,erased=false;const point=e=>{const r=canvas.getBoundingClientRect();return [Math.max(0,Math.min(1,(e.clientX-r.left)/r.width)),Math.max(0,Math.min(1,(e.clientY-r.top)/r.height))]};const erase=p=>{const run=spotComposer,at=run.drawings.findLastIndex(s=>spotStrokeDistance(p,s)<run.brush.width+8+s.width/2);if(at>=0){run.drawings=run.drawings.filter((_,i)=>i!==at);erased=true;spotPaintDrawing()}};
 svg.addEventListener('pointerdown',e=>{const run=spotComposer;if(!run?.drawingMode||run.saving||!e.isPrimary||id!==null)return;e.preventDefault();e.stopPropagation();id=e.pointerId;origin=run.drawings;erased=false;svg.setPointerCapture(id);if(run.brush.tool==='eraser'){erase(point(e));return}if(run.drawings.length>=50){id=null;return alertToast('يمكنك التراجع أو مسح بعض الرسم لإكماله')}stroke={id:spotUUID(),color:run.brush.color,width:run.brush.width,opacity:run.brush.tool==='marker'?.4:1,points:[point(e)]};draft=document.createElementNS('http://www.w3.org/2000/svg','path');draft.setAttribute('fill','none');draft.setAttribute('stroke',stroke.color);draft.setAttribute('stroke-width',stroke.width);draft.setAttribute('opacity',stroke.opacity);draft.setAttribute('stroke-linecap','round');draft.setAttribute('stroke-linejoin','round');draft.setAttribute('d',spotDrawingPath(stroke.points));svg.appendChild(draft)});
 svg.addEventListener('pointermove',e=>{const run=spotComposer;if(id!==e.pointerId||!run?.drawingMode)return;e.preventDefault();if(run.brush.tool==='eraser'){erase(point(e));return}if(!stroke)return;const p=point(e),last=stroke.points.at(-1);if(Math.hypot((p[0]-last[0])*360,(p[1]-last[1])*640)<1)return;if(stroke.points.length>=400)stroke.points=stroke.points.filter((_,i)=>i%2===0);stroke.points.push(p);draft.setAttribute('d',spotDrawingPath(stroke.points))});
 const finish=cancel=>{const run=spotComposer;if(id===null||!run)return;if(cancel){run.drawings=origin;spotPaintDrawing()}else if(stroke){spotDrawSnapshot(run);run.drawings=[...origin,...spotCleanDrawings([stroke])];spotPaintDrawing()}else if(erased){run.drawUndo.push(origin);if(run.drawUndo.length>25)run.drawUndo.shift();run.drawRedo=[]}id=null;stroke=null;draft=null;origin=null;erased=false;spotDrawPanel()};svg.addEventListener('pointerup',()=>finish(false));svg.addEventListener('pointercancel',()=>finish(true));svg.addEventListener('lostpointercapture',()=>{if(id!==null)finish(true)});
}
function spotHandleOverlayAction(act,id){const run=spotComposer;if(!run||!act.startsWith('overlay-'))return false;if(run.saving)return true;
 switch(act){case 'overlay-text':spotBeginTextAt();return true;case 'overlay-stickers':spotOpenEmoji();return true;case 'overlay-emoji-group':run.emojiGroup=Number(id);run.emojiLimit=96;spotRenderEmoji();return true;case 'overlay-emoji-more':run.emojiLimit+=96;spotRenderEmoji();return true;case 'overlay-emoji-pick':{const row=window.SPOT_EMOJI_CATALOG?.emoji[Number(id)];if(row)spotAddOverlay('sticker',row[0]);return true}case 'overlay-custom-emoji':{const text=$('#spotCustomEmoji')?.value.trim();if(text)spotAddOverlay('sticker',text.slice(0,120));return true}case 'overlay-draw':spotSetDrawing(!run.drawingMode);if(run.drawingMode)spotDrawPanel();else $('#spotOverlayPanel').innerHTML='';return true;case 'overlay-done':spotSetDrawing(false);run.overlays=run.overlays.filter(o=>o.kind!=='text'||o.text.trim());run.selectedOverlay='';spotPaintOverlays();$('#spotOverlayPanel').innerHTML='';return true;case 'overlay-pen':case 'overlay-marker':case 'overlay-eraser':run.brush.tool=act.slice(8);spotDrawPanel();return true;case 'overlay-brush-color':if(spotDrawColors[Number(id)])run.brush.color=spotDrawColors[Number(id)];spotDrawPanel();return true;case 'overlay-draw-undo':if(run.drawUndo.length){run.drawRedo.push(run.drawings);run.drawings=run.drawUndo.pop();spotPaintDrawing();spotDrawPanel()}return true;case 'overlay-draw-redo':if(run.drawRedo.length){run.drawUndo.push(run.drawings);run.drawings=run.drawRedo.pop();spotPaintDrawing();spotDrawPanel()}return true;case 'overlay-draw-clear':if(run.drawings.length){spotDrawSnapshot(run);run.drawings=[];spotPaintDrawing();spotDrawPanel()}return true;default:if(run.drawingMode)spotSetDrawing(false);return spotLegacyOverlayAction(act,id)}}
document.addEventListener('input',e=>{const run=spotComposer;if(!run||run.saving)return;if(e.target.id==='spotEmojiSearch'){run.emojiSearch=e.target.value;run.emojiLimit=96;spotRenderEmoji()}if(e.target.id==='spotBrushWidth')run.brush.width=Number(e.target.value)});
